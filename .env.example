# Savepoint Analytics - American Football Sabermetrics
SABER_ENV=dev
SABER_STORAGE_BACKEND=local
SABER_DATA_DIR=./data

# Local warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=saber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=saber_football

# MinIO / S3 raw storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=saber
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=football-sabermetrics
MINIO_PREFIX=

# NCAA / CollegeFootballData. Never commit a real key.
CFBD_API_KEY=

# Politeness / cache settings
SABER_NFLVERSE_RPM=60
SABER_CFBD_RPM=30
SABER_PFR_RPM=18
SABER_HTTP_CACHE_TTL_DAYS=7
SABER_USER_AGENT=savepoint-football-sabermetrics/0.1 (contact: alex@savepointanalytics.com)
